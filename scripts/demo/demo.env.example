# Backend settings for the local before/after demo (disposable databases from docker-compose.yml).
# run-demo.sh copies this to demo.env on first run and generates BETTER_AUTH_SECRET.
NODE_ENV=production
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_PASSWORD=frog
CLICKHOUSE_QUERY_PASSWORD=frog
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=frog
POSTGRES_PASSWORD=frog
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
BETTER_AUTH_SECRET=__GENERATE__
BASE_URL=http://localhost:8080
DISABLE_TELEMETRY=true
