<!-- Low-memory ClickHouse user profile for small sites (rybbit-unlocked fork).
     Mounted at /etc/clickhouse-server/users.d/zz_low_memory.xml by docker-compose.lowmem.yml,
     so it sorts after user_settings.xml and overrides max_memory_usage / max_threads there. -->
<clickhouse>
    <profiles>
        <default>
            <max_threads>2</max_threads>
            <max_memory_usage>734003200</max_memory_usage>
            <!-- Spill big GROUP BY / ORDER BY to disk instead of failing. -->
            <max_bytes_before_external_group_by>314572800</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>314572800</max_bytes_before_external_sort>
            <max_insert_threads>1</max_insert_threads>
            <!-- keep batching inserts (same as base profile) -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
        </default>
    </profiles>
</clickhouse>
